{
  "name": "gamedev-story-clone",
  "private": true,
  "version": "1.30.6",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Клон Game Dev Story (Kairosoft) — M1–M4: ядро (тик = день), Win95-UI + сервер (WS, GigaChat), персонал, рынок",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "play": "tsx scripts/playthrough.ts",
    "db:build": "tsx tools/build-db.ts",
    "avatars": "tsx tools/make-avatars.ts",
    "dev": "vite",
    "server": "tsx src/server/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"tools/**/*.ts\"",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "difficulty:gen": "tsx tools/gen-difficulty.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "3.0.0-beta.4",
    "byte-data": "^19.0.1",
    "classnames": "^2.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "invariant": "^2.2.4",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "music-metadata": "^11.15.0",
    "music-metadata-browser": "^2.5.11",
    "nodemailer": "^10.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^8.1.3",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0",
    "riff-file": "^1.0.3",
    "sharp": "^0.35.4",
    "strtok3": "^10.3.5",
    "tinyqueue": "^3.0.0",
    "ws": "^8.21.3"
  }
}