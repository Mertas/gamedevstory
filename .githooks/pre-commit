#!/bin/sh
# PLAN-33: каждый коммит обязан нести новую версию в package.json.
# Бампай перед коммитом: pnpm version patch|minor|major --no-git-tag-version
# (схема MAJOR.MINOR.PATCH — plan/23_Версионирование.md; осознанно выбирай уровень).
head_ver=$(git show HEAD:package.json 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1)
stage_ver=$(git show :package.json 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1)
if [ -z "$stage_ver" ]; then
  echo "✋ package.json не в индексе — версия не проверена. Сделай: git add package.json"
  exit 1
fi
if [ "$head_ver" = "$stage_ver" ]; then
  echo "✋ Версия в package.json не изменилась ($stage_ver) — коммит без бампа версии запрещён."
  echo "   Бампани: pnpm version patch|minor|major --no-git-tag-version"
  exit 1
fi
echo "✔ версия: ${head_ver:-нет} → $stage_ver"

# аудит-51 02-P3-4: грубый скан секретов по staged-файлам (приватные ключи и типовые токены).
# Служебные хуки из скана исключены, чтобы проверка не срабатывала на саму себя.
secret_hits=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^\.githooks/' | tr '\n' '\0' | xargs -0 -r grep -IlE 'BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY|sk-[A-Za-z0-9_-]{24,}' 2>/dev/null)
if [ -n "$secret_hits" ]; then
  echo "✋ Похоже на секреты в коммите:"
  echo "$secret_hits" | sed 's/^/   /'
  exit 1
fi
