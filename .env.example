# Скопируйте в .env и заполните (все ключи опциональны; без GigaChat чат и генерации молчат)

# ── GigaChat (чат и генерация сюжета — основной LLM) ──
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# ── DeepSeek (запасной; код отключён — только факт ключа в health) ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_FLASH_MODEL=
DEEPSEEK_BASE_URL=

# ── Сервер ──
PORT=3001
LLM_TIMEOUT_MS=90000
