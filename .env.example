# Переменные окружения GameDevStory. Скопировать в /srv/gds/shared/.env и заполнить (chmod 600).
# ВАЖНО: значения в git не попадают — .env в .gitignore.

# ─── сервер ───
HOST=127.0.0.1          # наружу смотрит только nginx
PORT=3001

# ─── публичный режим (plan/19) ───
PROD=1                  # выключает сброс пароля и включает прочие «взрослые» правила
# PASSWORD_RESET=0      # сброс пароля на публике выключен (на экране нет кнопки, эндпоинт отвечает «недоступно»)
# INVITE_REQUIRED=1     # регистрация только по инвайт-коду (владелец выдаёт их в окне «Инвайты»)

# ─── LLM: GigaChat (Сбер, тариф физлица, scope GIGACHAT_API_PERS) ───
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
LLM_TIMEOUT_MS=90000
# Резервный аккаунт GigaChat (LLM-08): используется, если основной не отвечает (нет токена, 401/429 и пр.)
GIGACHAT2_CLIENT_ID=
GIGACHAT2_CLIENT_SECRET=

# ─── фолбэк DeepSeek (в generateWithFallback не используется, оставлен на будущее) ───
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FLASH_MODEL=deepseek-chat

# ─── почта ───
# dev — письма файлом в data/mail-out (локально);
# api — SendPulse по HTTPS (публичный сервер: у VDSina исходящий SMTP закрыт);
# smtp — nodemailer, только если хостер разблокировал исходящий SMTP.
MAIL_MODE=api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Game Dev Studio <no-reply@mertas.space>
# SendPulse: либо статический ключ из кабинета (Настройки → API), либо пара id/secret (OAuth)
SENDPULSE_API_KEY=
SENDPULSE_ID=
SENDPULSE_SECRET=
# Перец для паролей: секрет сервера, обязателен в проде (PROD=1). Смена обнуляет все пароли.
GDS_PEPPER=
# Пароль сид-владельца — нужен только при создании базы с нуля.
GDS_OWNER_PASSWORD=
